<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="NewAll.master.cs" Inherits="WebApplication1.NewAll" %>

<%-- 游客母版页：带注册/登录入口的导航，未登录时访问的页面用这个 --%>
<!DOCTYPE html>
<html lang="zh-CN">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>微博 - 随时随地分享身边的新鲜事</title>
    <link rel="stylesheet" href="css/site.css">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <%-- ====== 顶部导航 ====== --%>
        <div class="nav">
            <div class="null"></div>
            <ul class="nav-left">
                <a href="Default.aspx"><img src="images/logo_tm.png" alt="微博" class="logo-image"></a>
                <div class="nav-search">
                    <input type="text" class="left-input" id="navKw" placeholder="搜索微博"
                        onkeydown="if(event.keyCode==13){doSearch();}" />
                    <button type="button" onclick="doSearch()">搜索</button>
                </div>
            </ul>
            <div class="null"></div>
            <ul class="nav-center">
                <li><a href="Default.aspx" class="center-item_link">首页</a></li>
                <li><a href="Jingxuan.aspx" class="center-item_link">微博精选</a></li>
                <li><a href="Guanzhu.aspx" class="center-item_link">发现</a></li>
                <li class="divider">|</li>
                <li><a href="register.aspx" class="center-item_link"><span class="right-span">注册</span></a></li>
                <li class="divider">|</li>
                <li><a href="Login.aspx" class="center-item_link"><span class="right-two">登录</span></a></li>
            </ul>
            <div class="null"></div>
        </div>

        <%-- ====== 内容区 ====== --%>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

        <%-- ====== 页脚 ====== --%>
        <div class="site-footer">
            <p>北京微梦创科网络技术有限公司 &nbsp;|&nbsp; 京ICP备12002058号-2</p>
            <p>Copyright &copy; 2009-<%=DateTime.Now.Year %> WEIBO &nbsp;&middot;&nbsp; 本站为课程作业演示用途</p>
        </div>

        <%-- 轮播图自动切换脚本：图与配文作为一项(.banner-item)整体切换 --%>
        <script type="text/javascript">
            // 顶部搜索：跳转到搜索页
            function doSearch() {
                var el = document.getElementById('navKw');
                var v = el ? el.value.replace(/^\s+|\s+$/g, '') : '';
                if (v) location.href = 'Search.aspx?kw=' + encodeURIComponent(v);
            }

            // 轮播图自动切换：图与配文作为一项(.banner-item)整体切换
            (function () {
                var index = 0;
                function changeImg() {
                    var items = document.getElementsByClassName("banner-item");
                    if (items.length <= 1) return;
                    index = (index + 1) % items.length;
                    for (var i = 0; i < items.length; i++) {
                        items[i].style.display = 'none';
                    }
                    items[index].style.display = 'block';
                }
                setInterval(changeImg, 3500);
            })();
        </script>
    </form>
</body>
</html>
